# Secrets
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# Scraped artifacts (keep the repo light).
#   raw_html/  -- 62MB of cached HTML, regenerable; stays ignored.
#   scraped_data/  -- the 4.9MB of cleaned per-source JSON from the 2026-06-28 scrape.
#     COMMITTED (not ignored) so a fresh clone can rebuild the EXACT frozen corpus via
#     `run_pipeline.py --from-cache --all` without re-scraping -- essential now that
#     travel.state.gov is Cloudflare-blocked and cannot be re-scraped.
raw_html/
data/

# Generated logs are artifacts -- but the weekly write-ups are deliverables, so keep
# the .md and ignore only the machine-written .json (cost/scrape/repair logs).
logs/*.json

# Console output captured from local runs (contains machine-specific paths).
*.log
scratchpad/*.out

# Local corpus dump used by the Week 6 audit harness -- 6MB, and fully
# regenerable from Qdrant via `python scratchpad/dump_corpus.py`.
scratchpad/corpus_dump.json

# OS / editor
.DS_Store
.idea/
.vscode/
