# Copy to .env and fill in. .env is gitignored - never commit real keys.

# --- OpenRouter (required for embedding) ---
OPENROUTER_API_KEY=sk-or-...
# Defaults below are fine; override only if needed.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=openai/text-embedding-3-large
EMBEDDING_USD_PER_1M_TOKENS=0.13
EMBED_BATCH_SIZE=20

# --- Qdrant (local Docker defaults) ---
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=            # only for Qdrant Cloud; leave blank for local
QDRANT_COLLECTION=wanderrag_chunks

# --- Chunking ---
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# --- Scraping ---
REQUEST_TIMEOUT=30
# USER_AGENT=WanderRAG/0.1 (class project; contact: you@example.edu)
